# ── LOCAL DEV ─────────────────────────────────────────────────────────────────
# Loaded automatically by `vite dev` / `pnpm dev` (Vite mode = "development").
# SAFE TO COMMIT: every VITE_* var is inlined into the browser bundle, so nothing
# secret can live here by definition. Values are public.

# Backend reached over the Cloudflare tunnel (NOT localhost).
# ⚠️ MUST be https:// — the browser blocks an http:// API call from an https page as
# mixed content, and a plain-http host that 301-redirects also breaks CORS preflight
# (browsers refuse to follow redirects on a preflighted request).
# ⚠️ NOT https://shipguard.app — that is the OLD Remix backend and has none of the
# /api/v1 routes (its login is the legacy POST /admin/api).
VITE_API_BASE_URL=https://backend.charming-wood.xyz

# Local backend instead, if you ever want it (http is fine here: localhost is a secure
# context, and the vite dev server is also http):
# VITE_API_BASE_URL=http://localhost:4000
