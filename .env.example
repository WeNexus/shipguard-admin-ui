# ── Template ──────────────────────────────────────────────────────────────────
# You normally do NOT need a `.env` here. Vite picks the right file per command:
#
#   pnpm dev     → .env.development   (committed, points at localhost)
#   pnpm build   → .env.production    (committed, points at the live API)
#
# Override just for your machine — these are gitignored:
#   .env.development.local   /   .env.production.local   /   .env.local
#
# Precedence (first wins): .env.<mode>.local → .env.<mode> → .env.local → .env

# Backend host. The `/api/v1` prefix is added by src/lib/api-client.ts — do not include it.
VITE_API_BASE_URL=

# ⚠️ NEVER put a secret in any file here. Vite inlines every VITE_* var into the
# public JS bundle. The admin JWT signing secret stays on the backend.
